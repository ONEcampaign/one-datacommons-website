### API keys ###

# API key for accessing the base Data Commons API.
DC_API_KEY=<YOUR_DC_API_KEY>
# API key for accessing Maps and Places APIs for exploration tools.
MAPS_API_KEY=<YOUR_MAPS_API_KEY>

### Directories ###

# Input directory (GCS path like gs://bucket/folder or absolute local path).
INPUT_DIR=gs://one-datacommons-staging/one-data
# Output directory (GCS path or absolute local path). Can be same as INPUT_DIR.
OUTPUT_DIR=gs://one-datacommons-staging/one-data-output

### DB parameters ###

# Use local SQLite as the database (set to false if using Cloud SQL).
USE_SQLITE=false
# Use Google Cloud SQL as the database.
USE_CLOUDSQL=false
# GCP project ID.
GOOGLE_CLOUD_PROJECT=one-data-commons
# Cloud SQL instance: <PROJECT_ID>:<LOCATION>:<INSTANCE_ID>
CLOUDSQL_INSTANCE=
# Cloud SQL database name.
DB_NAME=datacommons
# Cloud SQL database user.
DB_USER=datacommons
# Cloud SQL database password.
DB_PASS=<YOUR_DB_PASS>

### Docker registry (used by justfile for push/deploy) ###

# Full image path for docker push (without :tag).
DOCKER_REGISTRY=us-east4-docker.pkg.dev/one-data-commons/datacommons/website-compose
# GCP region for Artifact Registry auth.
GOOGLE_CLOUD_REGION=us-east4

### Application settings ###

# Flask environment name (matches custom_dc/<name> directory).
FLASK_ENV=one
# Enable the local mixer.
USE_LOCAL_MIXER=true
# Enable NL model.
ENABLE_MODEL=true

### Optional parameters ###

# SQL data path for imports.
SQL_DATA_PATH=gs://one-datacommons-imports/
# Redis Memorystore instance IP (optional).
REDIS_HOST=
# Secret token for /admin page (optional).
ADMIN_SECRET=<YOUR_ADMIN_SECRET>
# Google Analytics tag ID (optional).
GOOGLE_ANALYTICS_TAG_ID=
