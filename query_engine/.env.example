# QRE live-credentials template for the Phase-0 baseline freeze.
#
# Copy to .env and fill in the blanks (.env is gitignored; this file is not):
#   cp .env.example .env
#
# Nothing auto-loads .env. uv injects it with --env-file. The full sequence:
#   1. Sync the golden corpus into a Langfuse dataset (one time per corpus change):
#        uv run --env-file .env --extra eval python -m qre.eval.sync
#   2. Run the baseline experiment (scores the run on Langfuse):
#        uv run --env-file .env --extra eval --extra engine python scripts/run_experiment.py

# --- Required ---

# Gemini key for the engine's LLM calls (extract/bind). Live calls only.
GEMINI_API_KEY=

# Langfuse Cloud EU. PUBLIC/SECRET keys are in Langfuse UI -> Settings -> API Keys.
# EU cloud is https://cloud.langfuse.com (US would be https://us.cloud.langfuse.com).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# --- Optional (defaults shown; uncomment only to override) ---

# Graph target. Default is staging, which is correct for dev-finance (zero on prod).
# QRE_GRAPH_BASE=https://dc-staging.one.org

# Experiment/run name on Langfuse. Set a stable name to pin this as the baseline.
# QRE_ENGINE_BUILD=qre-baseline-v1

# LLM model. Default is the flash-lite alias.
# QRE_ENGINE_MODEL=gemini-flash-lite-latest
